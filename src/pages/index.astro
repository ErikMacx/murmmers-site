---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { published, latest, amazonUrl, countWord } from '../lib/books';

// The home page says what the press does before anything else, then shows
// one book: the newest. Every other book lives on /books/, so the catalogue
// is never shown twice.
const bookCount = countWord(published.length);
const amazon = latest ? amazonUrl(latest) : '';
const hasDirect = !!latest?.payhip_url;
const firstPara = latest?.blurb?.[0] ?? latest?.description ?? '';
---

<Base title="Murmmers Press" type="website">
  {hasDirect && <script slot="head" src="https://payhip.com/payhip.js" async></script>}

  <section class="home-hero">
    <div class="wrap home-hero-grid">
      <div>
        <span class="eyebrow">An independent publishing house · Fiction with soul</span>
        <h1>Stories to lose yourself in.</h1>
        <p class="lead">Every book here is its own world. Some are simply a good story, and some go deeper, but every one leaves you a little better than it found you. We publish each in its author's own voice, and we can do the same for yours.</p>
        <div class="cta-row">
          <a class="btn" href="/books/">Find a book</a>
          <a class="btn ghost" href="/for-authors/">For authors</a>
        </div>
        <div class="meta">
          <span><i class="dot"></i>{bookCount} books out</span>
          <span><i class="dot"></i>A human at every gate</span>
          <span><i class="dot"></i>Amazon and direct</span>
        </div>
      </div>

      <aside class="what-panel" aria-label="What we do">
        <p class="label">What we do</p>
        <div class="what-item">
          <span class="n n1">01</span>
          <div>
            <h3>Books for readers</h3>
            <p>Novels, fables and true stories, each unlike the others. Read them for the story. The rest arrives quietly, on its own.</p>
            <a href="/books/">Browse the books</a>
          </div>
        </div>
        <div class="what-item">
          <span class="n n2">02</span>
          <div>
            <h3>Publishing for authors</h3>
            <p>You hand us a finished manuscript. We carry it the rest of the way: the edit, the cover, the ISBNs, every shop, the launch.</p>
            <a href="/for-authors/">How it works for authors</a>
          </div>
        </div>
        <div class="what-item">
          <span class="n n3">03</span>
          <div>
            <h3>A house run by machines</h3>
            <p>AI agents do the tireless work, and a human decides at every gate. The whole house is run by machines. The books are not.</p>
            <a href="/how-we-work/">How we work</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {latest && (
    <section class="home-latest">
      <div class="wrap">
        <article class="book-detail">
          <a href={`/books/${latest.slug}/`} aria-label={latest.title}>
            <Cover book={latest} widths={[320, 640]} sizes="(max-width: 46rem) 60vw, 20rem" loading="eager" />
          </a>
          <div>
            <p class="eyebrow">Just published</p>
            <h2 class="latest-title"><a href={`/books/${latest.slug}/`}>{latest.title}</a></h2>
            {latest.subtitle && <p class="subtitle">{latest.subtitle}</p>}
            {latest.tagline && <p class="tagline">{latest.tagline}</p>}
            <p class="prose">{firstPara}</p>
            <div class="buys">
              {amazon && <a class="btn" href={amazon}>Buy on Amazon</a>}
              {hasDirect && (
                <a class="btn ghost payhip-buy-button" data-theme="none"
                   data-product={latest.payhip_url.split('/').pop()}
                   href={latest.payhip_url}>Buy the ebook direct from Murmmers</a>
              )}
            </div>
            <p class="latest-links">
              <a href={`/books/${latest.slug}/`}>More about {latest.title}</a>
              <span aria-hidden="true"> · </span>
              <a href="/books/">All {bookCount.toLowerCase()} books</a>
            </p>
          </div>
        </article>
      </div>
    </section>
  )}

  <section class="landing-medicine">
    <div class="wrap">
      <h2>A book can be two kinds of medicine.</h2>
      <div class="pair">
        <p><em>A mirror,</em> that holds your face in the dark until you know it again.</p>
        <p><em>A voice,</em> that sits down beside you and asks for nothing at all.</p>
      </div>
      <p class="claim">To be seen. To be heard. Every book here does a little of both, even the ones you read purely for the story.</p>
    </div>
  </section>

  <section class="landing-manifesto">
    <div class="wrap">
      <p>Murmmers Press. Fiction with soul. Every book kept, to the last breath, in its own true voice.</p>
      <p class="come-in">Come in. Something here has been holding your place.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <EmailSignup heading="Stay close" note="A letter when a new book arrives. Nothing else, ever." />
    </div>
  </section>
</Base>
